GOL_PORT=3003
GOL_LOG_DIR=./logs

# Optional server flags.
GOL_BASE_URL=/
GOL_EVERY=10
GOL_LIMIT=1000
GOL_ACCESS=false

# File log mode. Use \n when you need several -f flags from this .env file:
# GOL_FILE_PATTERNS=/logs/*.log\n/logs/*.log.*
GOL_FILE_PATTERNS=/logs/*.log

# SSH log mode. Mount SSH keys and known_hosts into /home/gol/.ssh before enabling this.
# Quote the value when key_passphrase contains #. Spaces inside key_passphrase are not supported.
# Use either password= or private_key= for a target, not both.
# GOL_SSH_TARGETS="user@host private_key=/home/gol/.ssh/id_rsa key_passphrase=pa#ss.phrase known_hosts=/home/gol/.ssh/known_hosts /var/log/*.log"
GOL_SSH_TARGETS=

# Docker log mode. Mount /var/run/docker.sock and usually run as root.
GOL_DOCKER_ALL=false
# Use \n for several -d flags from this .env file. Example:
# GOL_DOCKER_TARGETS=container-name\ncontainer-id /app/logs.log
GOL_DOCKER_TARGETS=
